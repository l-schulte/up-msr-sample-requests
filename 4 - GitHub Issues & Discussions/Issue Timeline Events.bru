meta {
  name: Issue Timeline Events
  type: http
  seq: 4
}

get {
  url: {{github_base_url}}/repos/{{github_owner}}/{{github_repo}}/issues/{{sample_issue_number}}/events
  body: none
  auth: none
}

headers {
  Accept: application/vnd.github+json
  ~Authorization: Bearer {{github_token}}
}

docs {
  MSR Goal: Issue event logs. Returns state transitions, label attachments, reassignments, cross-references from commits, and close/reopen events.
}
