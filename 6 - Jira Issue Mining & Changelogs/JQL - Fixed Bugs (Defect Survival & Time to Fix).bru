meta {
  name: JQL - Fixed Bugs (Defect Survival & Time to Fix)
  type: http
  seq: 2
}

get {
  url: {{jira_base_url}}/search
  body: none
  auth: none
}

params:query {
  jql: project = IGNITE AND issuetype = Bug AND status in (Resolved, Closed) AND resolution = Fixed ORDER BY updated DESC
  fields: summary,status,resolution,created,resolutiondate,priority,components,fixVersions,assignee
  maxResults: 50
  startAt: 0
}

headers {
  Accept: application/json
}

docs {
  MSR Goal: Defect Survival & Resolution Time. Retrieves verified fixed bugs. Fix time is calculated as (resolutiondate - created). Used for survival analysis and bug severity vs fix duration models.
}
